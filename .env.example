# 複製此檔為 .env 並填入真實設定
# cp .env.example .env

# ── Gmail 設定 ────────────────────────────────────────────────────────────────
# 寄件者 Gmail 帳號（完整 email 地址）
GMAIL_SENDER=yourname@gmail.com

# Gmail 應用程式密碼（非登入密碼，共 16 碼含空格）
# 產生方式：Google 帳號 → 安全性 → 兩步驟驗證 → 應用程式密碼 → 選「其他」
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 收件者（多個收件者以逗號分隔）
GMAIL_RECIPIENTS=recipient@example.com,another@example.com

# ── 監控設定（可選，有預設值）────────────────────────────────────────────────
# 輪詢間隔秒數（預設 60）
# MONITOR_POLL_INTERVAL=60

# 單日漲幅警報閾值 % （預設 5.0）
# MONITOR_ALERT_RISE_PCT=5.0

# 單日跌幅警報閾值 % （預設 -5.0，填負數）
# MONITOR_ALERT_FALL_PCT=-5.0

# 每日摘要寄送時間（台灣時間 24h，預設 14:00）
# MONITOR_SUMMARY_TIME=14:00

# 每日摘要排行榜顯示前 N 名（預設 10）
# MONITOR_SUMMARY_TOP_N=10

# 批次視窗秒數：同時觸發的股票等待此秒數後合併成一封信（預設 30）
# MONITOR_BATCH_WINDOW=30
